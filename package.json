{
  "name": "syncbridge",
  "displayName": "Syncbridge",
  "description": "AI chat to CLI sync bridge",
  "publisher": "rehmansherazi",
  "version": "0.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/rehmansherazi/syncbridge"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": ["ai", "cli", "sync", "claude", "automation", "chat"],
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#1e1e1e", "theme": "dark" },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "syncbridge.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "syncbridge.openPanel",
        "title": "Syncbridge: Open Panel"
      },
      {
        "command": "syncbridge.sendToCLI",
        "title": "Syncbridge: Send Clipboard to CLI"
      },
      {
        "command": "syncbridge.setRoot",
        "title": "Syncbridge: Set Active Project"
      },
      {
        "command": "syncbridge.setupProject",
        "title": "Syncbridge: Setup Project"
      },
      {
        "command": "syncbridge.openUsage",
        "title": "Syncbridge: Open Claude Usage"
      }
    ],
    "configuration": {
      "title": "Syncbridge",
      "properties": {
        "syncbridge.activeCli": {
          "type": "string",
          "default": "claudecode",
          "enum": ["claudecode", "cursor", "copilot", "windsurf", "aider", "custom"],
          "enumDescriptions": [
            "Claude Code CLI (default) — full auto-sync support",
            "Cursor — manual state sync only",
            "Microsoft Copilot CLI — manual state sync only",
            "Windsurf — manual state sync only",
            "Aider — manual state sync only",
            "Custom — use custom file names"
          ],
          "description": "The AI coding CLI you are using. Controls control file names and panel labels."
        },
        "syncbridge.customInstructionsFile": {
          "type": "string",
          "default": "ai-instructions.md",
          "description": "Custom instructions file name (only used when activeCli is 'custom')"
        },
        "syncbridge.customStateFile": {
          "type": "string",
          "default": "ai-state.md",
          "description": "Custom state file name (only used when activeCli is 'custom')"
        },
        "syncbridge.customContextFile": {
          "type": "string",
          "default": "ai-context.md",
          "description": "Custom context file name (only used when activeCli is 'custom')"
        }
      }
    },
    "keybindings": [
      {
        "command": "syncbridge.openPanel",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "syncbridge.sendToCLI",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x"
      },
      {
        "command": "syncbridge.setRoot",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "syncbridge.setupProject",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
